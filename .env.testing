APP_ENV=testing
APP_KEY=base64:Ds89n6WO0185svU1GKDUNc8/ZkSS4GxXhIu796Ez85A=
APP_DEBUG=true

BCRYPT_ROUNDS=4

# cascade削除・CHECK制約・enumの挙動をSQLiteとの差異なく検証するため、
# テストもdocker-composeのdbサービス(postgres)上の別データベースに対して行う。
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=laravel_testing
DB_USERNAME=laravel
DB_PASSWORD=secret

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array

# テストではAPIキーを使わず、GradingServiceをFakeGradingServiceに固定する。
# 万が一バインドを誤ってもClaude APIには絶対に到達しないよう、キー自体もダミー値にしておく。
ANTHROPIC_API_KEY=testing-key-not-used
GRADING_DRIVER=fake

MAX_QUESTIONS_PER_SECTION=10
